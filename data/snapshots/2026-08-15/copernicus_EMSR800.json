{"count":1,"next":null,"previous":null,"results":[{"code":"EMSR800","name":"Flood in Lombardy - Italy","reason":"Intense bad weather hit Northern Italy's regions during the night of 16-17 April. The event was characterised by heavy precipitation, snow and strong winds that persisted the following day. As a consequence, numerous landslides, some disruption of roads and power lines occurred in particular in Piemonte and Valle d'Aosta Region. Many rivers reached the third watch level. Heavy rainfall also affected the Po River basin in the mountains, resulting in the river flooding in some parts of the river course. Copernicus EMS Rapid Mapping was requested to provide flood extent and damage assessment emergency mapping.","category":"Flood","subCategory":"Flash flood","sensitive":false,"reportLink":"https://storymaps.arcgis.com/stories/fcac1dc534464682bacc15c3ffdc7b57","activator":"Italy|Presidency of the Council of Ministers - Italian Department of Civil Protection","eventTime":"2025-04-17T00:00:00","activationTime":"2025-04-18T11:00:00","closed":true,"gdacsId":null,"continent":"Europe","countries":[{"name":"Italy"}],"aois":[{"name":"San Sebastiano da Po","extent":"POLYGON ((7.912422 45.186712, 7.968713 45.178732, 7.956856 45.158654, 7.953572 45.158475, 7.947685 45.160032, 7.932443 45.157723, 7.912422 45.186712))","number":1,"activationCode":"EMSR800","products":[{"id":1603,"type":"DEL","monitoring":false,"monitoringNumber":0,"feasible":true,"images":[{"uuid":"4b767c63-c276-4949-b2f4-fc0fe1c6683c","new":true,"sensorType":"sar","sensorName":"Sentinel-1","resolutionClass":"HR+","acquisitionTime":"2025-04-21T05:34:00","fileName":"EMSR800_AOI01_DEL_PRODUCT_SENTINEL1_20250421_0534_ORTHO.tif"}],"stats":null,"mapsCount":0,"activationCode":"EMSR800","aoiName":"San Sebastiano da Po","aoiNumber":1,"extent":"POLYGON ((7.932443 45.157723, 7.947685 45.160032, 7.953572 45.158475, 7.956856 45.158654, 7.968713 45.178732, 7.912422 45.186712, 7.932443 45.157723))","expectedDelivery":nu