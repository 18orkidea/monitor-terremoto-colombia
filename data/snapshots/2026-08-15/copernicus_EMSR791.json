{"count":1,"next":null,"previous":null,"results":[{"code":"EMSR791","name":"Snowfall impact in Guria, Georgia","reason":"Since February 20, 2025, heavy snowfall has paralyzed movement in Guria, Georgia, leaving many villages cut off from essential services. Residents have been without electricity, gas, and road access, leading to dire conditions. One individual tragically died after falling while helping a neighbor clear snow from a roof. The intense snowfall has also caused significant physical damage, with some house roofs collapsing under the weight and fallen trees further blocking already impassable roads. Copernicus EMS Rapid Mapping is requested to provide damage assessment emergency mapping.","category":"Other","subCategory":"Other","sensitive":false,"reportLink":"https://storymaps.arcgis.com/stories/b0f179f972ca4a23b3fd224b21d111fe","activator":"EU Services|EEAS (EU Intelligence Analysis Centre), Delegations of the European Union","eventTime":"2025-02-20T00:00:00","activationTime":"2025-02-27T15:37:00","closed":true,"gdacsId":null,"continent":"Asia","countries":[{"name":"Georgia"}],"aois":[{"name":"Sakavia","extent":"POLYGON ((41.759377 42.026963, 41.761168 42.029302, 41.763849 42.030552, 41.798615 42.036895, 41.81445 42.045339, 41.81554 42.045813, 41.851116 42.056555, 41.854511 42.056586, 41.857396 42.054793, 41.8996 42.007683, 41.900759 42.005323, 41.901053 42.004705, 41.901011 42.004281, 41.900727 42.001408, 41.900718 42.001396, 41.898719 41.998781, 41.892031 41.993801, 41.859885 41.969813, 41.827705 41.945798, 41.825252 41.944705, 41.773533 41.934555, 41.773503 41.934549, 41.771464 41.934723, 41.770167 41.934829, 41.76749 41.93685, 41.767347 41.937219, 41.766289 41.939962, 41.765495 41.949059, 41.758912 42.024027, 41.759364 42.026868, 41.759364 42.026871, 41.759377 42.026963))","number":1,"activationCode":"EMSR791","products":[{"id":1427,"type":"GRA","monitoring":false,"monitoringNumber":0,"feasible":true,"images":[{"uuid":"7c1396ff-3891-4392-b5ef-4c4ec