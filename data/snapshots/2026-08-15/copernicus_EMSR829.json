{"count":1,"next":null,"previous":null,"results":[{"code":"EMSR829","name":"Wildfire in Western Greece, Greece","reason":"On the 08 August 2025 at 15:22 UTC, a serious wildfire is reported to have affected Western Greece Region, near Hrakleia village, 12 Km east from the city of Pyrgos, Greece. A large number of firefighters, volunteers, fire engines, water tankers, construction machinery, airplanes and helicopters were mobilized to suppress the fire. The residents of Hrakleia, Lajoi, Grammatikos and Pournari villages had to be evacuated, and a 112 cell-broadcasting message was sent for this purpose. Copernicus EMS Rapid Mapping is requested to provide wildfire initial rough estimation, wildfire extent and monitoring emergency mapping.","category":"Wildfire","subCategory":"Forest fire","sensitive":false,"reportLink":"https://storymaps.arcgis.com/stories/676b42f38d214cf888eed8b122998e79","activator":"Greece|Disaster Planning and Management Directorate - General secretariat for Civil protection - Ministry of Climate Change and Civil Protection","eventTime":"2025-08-08T15:22:00","activationTime":"2025-08-09T11:32:00","closed":true,"gdacsId":null,"continent":"Europe","countries":[{"name":"Greece"}],"aois":[{"name":"Hrakleia","extent":"POLYGON ((21.509741 37.728313, 21.652974 37.72808, 21.651872 37.651778, 21.509628 37.652347, 21.509741 37.728313))","number":1,"activationCode":"EMSR829","products":[{"id":1754,"type":"DEL","monitoring":true,"monitoringNumber":1,"feasible":false,"images":[{"uuid":"53566927-9215-481f-bb1e-0003f6e137a5","new":true,"sensorType":"optical","sensorName":"SPOT-6-7","resolutionClass":"VHR2","acquisitionTime":"2025-08-10T09:21:00","fileName":""}],"stats":null,"mapsCount":0,"activationCode":"EMSR829","aoiName":"Hrakleia","aoiNumber":1,"extent":"POLYGON ((21.509628 37.652347, 21.651872 37.651778, 21.652974 37.72808, 21.509741 37.728313, 21.509628 37.652347))","expectedDelivery":null,"layers":[],"downloadPath":"","version":{"uuid":"f0e0917c-e4a9-40d0-