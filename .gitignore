# Videos ciudadanos: se conservan localmente con sha256 registrado en la BD,
# pero no se versionan (tamaño). Las imágenes sí entran en git.
data/media/*.mp4
data/media/*.mov
data/media/*.avi
data/media/*.webm
data/media/*.opus
data/media/*.ogg
data/media/*.m4a

# la BD no se versiona: se reconstruye desde data/dumps/*.csv (dump_db.py)
data/monitor.sqlite

# ficheros de trabajo de SQLite (WAL)
data/monitor.sqlite-wal
data/monitor.sqlite-shm

node_modules/
__pycache__/
*.pyc
.DS_Store
dist/
.pytest_cache/
.benchmarks/

# nunca versionar credenciales
.env
.env.*
*.pem
*.key
*token*
!package-lock.json

# .claude/: solo se versionan launch, agentes y skills — las notas de trabajo
# y la memoria personal viven fuera del repo (ver CLAUDE.md)
.claude/*
!.claude/launch.json
!.claude/agents/
!.claude/skills/
