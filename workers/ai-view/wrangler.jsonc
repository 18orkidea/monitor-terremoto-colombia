{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "monitor-terremoto-colombia-oficiales-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "kv_namespaces": [
    {
      "binding": "OFFICIAL_DATA",
      "id": "d1a04716f48b43338476253682193982"
    }
  ],
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "vars": {
    "QWEN_OCR_MODEL": "qwen-vl-ocr-2025-11-20",
    "QWEN_API_URL": "https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation",
    "FIRECRAWL_API_URL": "https://api.firecrawl.dev/v2/search",
    "FIRECRAWL_SCRAPE_API_URL": "https://api.firecrawl.dev/v2/scrape"
  }
}
